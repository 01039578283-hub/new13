{
  "cleanUrls": true,
  "trailingSlash": true,
  "buildCommand": "node release-public-build.mjs && node wawa-analytics-build.mjs wawa-14 .public-release && node seo-descriptions.mjs --root=.public-release && node image-order-build.mjs && node crawl-quality-build.mjs",
  "outputDirectory": ".public-release",
  "headers": [
    {
      "source": "/assets/:path*",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[0-9a-f]{16}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/media-quality/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/quality/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
